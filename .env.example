# Project Icarus — environment template.
#
#   cp .env.example .env      # .env is gitignored; this file is not
#
# Nothing here is required for the offline demo. `make demo` and
# `OFFLINE=1 python -m src.acquire.firms` read only from cache/ and
# demo_fixtures/ and need no key.

# --- FIRMS downloads (src/acquire/firms.py) -------------------------------

# NASA FIRMS MAP_KEY, required for `make cache`. Request a free key at
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Read from the process environment first, then from .env.
FIRMS_MAP_KEY=

# The list of FIRMS source ids to download, comma-separated, in order.
# Default: MODIS_SP,VIIRS_SNPP_SP,VIIRS_NOAA20_SP,VIIRS_NOAA21_NRT
# (see PRODUCTS in src/acquire/firms.py).
# FIRMS_PRODUCTS=

# Region and window. Defaults: the pilot bbox 88,20,93,27 and
# 2003-01-01 .. 2026-09-30, intersected with each product's own window.
# Bounding box as west,south,east,north.
# FIRMS_BBOX=88,20,93,27
# ISO dates.
# FIRMS_START=2003-01-01
# FIRMS_END=2026-09-30

# Force offline operation: read from cache/ then demo_fixtures/, never the
# network. Any of 1 / true / yes (src/acquire/safe.py).
# OFFLINE=1

# --- Web frontend (web/, Vite) --------------------------------------------

# Data tier: `mock` (bundled payloads, offline, the default) or `api` (the
# live backend). A `--mode release` build refuses to ship on `mock`
# (web/vite.config.ts).
# VITE_DATA=api
# Base URL the frontend calls when VITE_DATA=api.
# VITE_API_BASE=http://127.0.0.1:8011/api/v1

# --- Reserved: external data (not read by any current code) ---------------

# The MCD64CMQ burned-area cross-check (E8 in docs/VALIDATION.md) downloads
# from LAADS DAAC, which is gated by Earthdata Login. Scripted downloads must
# use an Earthdata Download (EDL) bearer token, not your account password:
#
#   log in at https://urs.earthdata.nasa.gov, then "Generate Token" ->
#   "Show Token" and copy the value. Tokens expire after ~60 days.
#
# Sent as `Authorization: Bearer <token>`; LAADS also needs redirects and a
# cookie jar (curl -L -b session). No code reads this yet.
# EARTHDATA_TOKEN=
# NASA_API_KEY=
