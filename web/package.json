    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
