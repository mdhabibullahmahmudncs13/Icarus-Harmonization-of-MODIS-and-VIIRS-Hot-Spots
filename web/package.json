    "preview": "./node_modules/.bin/vite preview",
    "test": "./node_modules/.bin/vitest run",
    "test:e2e": "./node_modules/.bin/playwright test",
    "lint": "./node_modules/.bin/eslint . && ./node_modules/.bin/prettier --check .",
    "format": "./node_modules/.bin/prettier --write .",
    "mock:gen": "./node_modules/.bin/tsx scripts/gen-mock.ts",
    "land:gen": "./node_modules/.bin/tsx scripts/gen-landmask.ts",
    "contract:export": "./node_modules/.bin/tsx scripts/export-contract.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
