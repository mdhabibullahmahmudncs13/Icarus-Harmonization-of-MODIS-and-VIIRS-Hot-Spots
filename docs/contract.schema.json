{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icarus.local/contract.schema.json",
  "title": "Icarus API Contract",
  "description": "Frozen JSON contract for Project Icarus (Phase 0). One $defs entry per payload. Consumers validate a given payload with a $ref to the matching def, e.g. {\"$ref\": \"#/$defs/series\", \"$defs\": <this.$defs>}.",
  "$defs": {
    "source": {
      "type": "string",
      "enum": [
        "mock",
        "fixture",
        "cache",
        "live"
      ]
    },
    "binSource": {
      "type": "string",
      "enum": [
        "MODIS",
        "BRIDGE",
        "VIIRS_CAL",
        "NONE"
      ],
      "description": "Which observing stream anchors a series bin (S7, docs/DATA_DICTIONARY.md §5)."
    },
    "bbox": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4,
      "description": "[west, south, east, north]"
    },
    "metaBlock": {
      "type": "object",
      "required": [
        "source",
        "generated_at",
        "region",
        "cell_km",
        "min_confidence",
        "date_range",
        "params_hash"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "generated_at": {
          "type": "string"
        },
        "region": {
          "type": "object",
          "required": [
            "bbox"
          ],
          "properties": {
            "bbox": {
              "$ref": "#/$defs/bbox"
            }
          },
          "additionalProperties": true
        },
        "cell_km": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "min_confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "date_range": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "date"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "params_hash": {
          "type": "string",
          "minLength": 8
        }
      },
      "additionalProperties": true
    },
    "metaResponse": {
      "type": "object",
      "required": [
        "meta",
        "sensors",
        "years",
        "streams"
      ],
      "properties": {
        "meta": {
          "$ref": "#/$defs/metaBlock"
        },
        "sensors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "product",
              "family",
              "start",
              "end"
            ],
            "properties": {
              "product": {
                "type": "string"
              },
              "family": {
                "type": "string",
                "enum": [
                  "MODIS",
                  "VIIRS"
                ]
              },
              "start": {
                "type": "string",
                "format": "date"
              },
              "end": {
                "type": "string",
                "format": "date"
              }
            },
            "additionalProperties": false
          }
        },
        "years": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer"
            },
            "end": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "streams": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "seriesPoint": {
      "type": "object",
      "required": [
        "date",
        "raw_modis",
        "raw_viirs",
        "raw_total",
        "harm_modis",
        "harm_viirs",
        "harm_total",
        "coverage",
        "source"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "raw_modis": {
          "type": "integer",
          "minimum": 0
        },
        "raw_viirs": {
          "type": "integer",
          "minimum": 0
        },
        "raw_total": {
          "type": "integer",
          "minimum": 0
        },
        "harm_modis": {
          "type": "integer",
          "minimum": 0
        },
        "harm_viirs": {
          "type": "integer",
          "minimum": 0
        },
        "harm_total": {
          "type": "integer",
          "minimum": 0
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "$ref": "#/$defs/binSource"
        }
      },
      "additionalProperties": false
    },
    "series": {
      "type": "object",
      "required": [
        "meta",
        "metric",
        "bin_days",
        "series"
      ],
      "properties": {
        "meta": {
          "$ref": "#/$defs/metaBlock"
        },
        "metric": {
          "type": "string",
          "enum": [
            "density",
            "cell_days"
          ]
        },
        "bin_days": {
          "type": "integer",
          "enum": [
            1,
            8
          ]
        },
        "series": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/seriesPoint"
          }
        }
      },
      "additionalProperties": false
    },
    "cellPoint": {
      "type": "object",
      "required": [
        "cell_id",
        "bounds",
        "raw",
        "harmonized",
        "peak_frp"
      ],
      "properties": {
        "cell_id": {
          "type": "string"
        },
        "bounds": {
          "$ref": "#/$defs/bbox"
        },
        "raw": {
          "type": "integer",
          "minimum": 0
        },
        "harmonized": {
          "type": "integer",
          "minimum": 0
        },
        "peak_frp": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "cells": {
      "type": "object",
      "required": [
        "meta",
        "window",
        "cells"
      ],
      "properties": {
        "meta": {
          "$ref": "#/$defs/metaBlock"
        },
        "window": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string",
              "format": "date"
            },
            "end": {
              "type": "string",
              "format": "date"
            }
          },
          "additionalProperties": false
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cellPoint"
          }
        }
      },
      "additionalProperties": false
    },
    "baselinePoint": {
      "type": "object",
      "required": [
        "doy",
        "p05",
        "p25",
        "p50",
        "p75",
        "p95"
      ],
      "properties": {
        "doy": {
          "type": "integer",
          "minimum": 1,
          "maximum": 366
        },
        "p05": {
          "type": "number",
          "minimum": 0
        },
        "p25": {
          "type": "number",
          "minimum": 0
        },
        "p50": {
          "type": "number",
          "minimum": 0
        },
        "p75": {
          "type": "number",
          "minimum": 0
        },
        "p95": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "required": [
        "meta",
        "window_days",
        "years_used",
        "baseline"
      ],
      "properties": {
        "meta": {
          "$ref": "#/$defs/metaBlock"
        },
        "window_days": {
          "type": "integer",
          "minimum": 1
        },
        "years_used": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "baseline": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/baselinePoint"
          }
        }
      },
      "additionalProperties": false
    },
    "anomalyFlag": {
      "type": "string",
      "enum": [
        "normal",
        "elevated",
        "extreme",
        "not_scored"
      ]
    },
    "anomalies": {
      "type": "object",
      "required": [
        "meta",
        "query",
        "value",
        "percentile",
        "flag",
        "baseline_window",
        "doy_range",
        "years_used",
        "reason"
      ],
      "properties": {
        "meta": {
          "$ref": "#/$defs/metaBlock"
        },
        "query": {
          "type": "object",
          "required": [
            "date",
            "aoi"
          ],
          "properties": {
            "date": {
              "type": "string",
              "format": "date"
            },
            "aoi": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "percentile": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "flag": {
          "$ref": "#/$defs/anomalyFlag"
        },
        "baseline_window": {
          "type": "integer",
          "minimum": 1
        },
        "doy_range": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "years_used": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "criticalPeriod": {
      "type": "object",
      "required": [
        "meta",
        "aoi",
        "insufficient_activity",
        "onset_bin",
        "peak_bin",
        "end_bin",
        "window",
        "year_timing_deviation"
      ],
      "properties": {
        "meta": {
          "$ref": "#/$defs/metaBlock"
        },
        "aoi": {
          "type": "string"
        },
        "insufficient_activity": {
          "type": "boolean"
        },
        "onset_bin": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 46
        },
        "peak_bin": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 46
        },
        "end_bin": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 46
        },
        "window": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "start_bin",
            "end_bin",
            "mass"
          ],
          "properties": {
            "start_bin": {
              "type": "integer",
              "minimum": 1,
              "maximum": 46
            },
            "end_bin": {
              "type": "integer",
              "minimum": 1,
              "maximum": 46
            },
            "mass": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "year_timing_deviation": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "year",
              "days"
            ],
            "properties": {
              "year": {
                "type": "integer"
              },
              "days": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": [
        "meta",
        "overlap",
        "raw",
        "harmonized",
        "cell_sweep"
      ],
      "properties": {
        "meta": {
          "$ref": "#/$defs/metaBlock"
        },
        "overlap": {
          "type": "object",
          "required": [
            "years",
            "n_days"
          ],
          "properties": {
            "years": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "n_days": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "raw": {
          "$ref": "#/$defs/correlation"
        },
        "harmonized": {
          "$ref": "#/$defs/correlation"
        },
        "cell_sweep": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "cell_km",
              "raw_correlation",
              "harmonized_correlation"
            ],
            "properties": {
              "cell_km": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "raw_correlation": {
                "type": "number"
              },
              "harmonized_correlation": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "correlation": {
      "type": "object",
      "required": [
        "pearson",
        "spearman",
        "ratio"
      ],
      "properties": {
        "pearson": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1,
          "maximum": 1
        },
        "spearman": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1,
          "maximum": 1
        },
        "ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "methods": {
      "type": "object",
      "required": [
        "meta",
        "cell_km",
        "min_confidence",
        "confidence_mapping",
        "collapse_rule",
        "notices",
        "datasets"
      ],
      "properties": {
        "meta": {
          "$ref": "#/$defs/metaBlock"
        },
        "cell_km": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "min_confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "confidence_mapping": {
          "type": "object",
          "required": [
            "low",
            "nominal",
            "high"
          ],
          "properties": {
            "low": {
              "type": "integer"
            },
            "nominal": {
              "type": "integer"
            },
            "high": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "collapse_rule": {
          "type": "string"
        },
        "notices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "datasets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "product",
              "sensor",
              "used_for",
              "url"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "product": {
                "type": "string"
              },
              "sensor": {
                "type": "string"
              },
              "used_for": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "aoi": {
      "type": "object",
      "required": [
        "meta",
        "presets"
      ],
      "properties": {
        "meta": {
          "$ref": "#/$defs/metaBlock"
        },
        "presets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "bbox"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "bbox": {
                "$ref": "#/$defs/bbox"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
